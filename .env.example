# ============================================================
# CrewAI MCP Server — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- MCP Server Transport ---
# Options: stdio (default, for local clients), sse, streamable-http
CREWAI_MCP_TRANSPORT=stdio
# Bind address for sse/streamable-http. Keep 127.0.0.1 for local use;
# use 0.0.0.0 only inside containers (see docker-compose.yml).
CREWAI_MCP_HOST=127.0.0.1
CREWAI_MCP_PORT=8808

# --- Paths ---
# Path to the scraped CrewAI documentation (relative or absolute)
CREWAI_DOCS_PATH=./docs
# Workspace directory where CrewAI projects will be created/managed
CREWAI_WORKSPACE=./workspace
# Path to the ChromaDB vector store for the RAG knowledge engine
CREWAI_KNOWLEDGE_DB=./knowledge_db

# --- LLM API Keys (needed by CrewAI projects, not the MCP server itself) ---
# The RAG knowledge engine uses ChromaDB's built-in local embedder — no key needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
